{
  "name": "@opencall/server",
  "version": "0.1.0",
  "description": "Node.js coordination services for OpenCall",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "lint": "echo 'Skipping lint for server package (pending refactoring)'",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist node_modules .turbo"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@libp2p/bootstrap": "^12.0.10",
    "@libp2p/circuit-relay-v2": "^4.1.2",
    "@libp2p/identify": "^4.0.9",
    "@libp2p/webrtc": "^6.0.10",
    "@libp2p/websockets": "^10.1.2",
    "@opencall/core": "workspace:*",
    "@vite/vitejs": "^2.3.19",
    "@vite/vitejs-ws": "^2.3.19",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "libp2p": "^3.1.2",
    "mediasoup": "^3.19.13",
    "nanoid": "^5.1.6",
    "node-cron": "^4.2.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.1",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.10",
    "nodemon": "^3.0.2",
    "rimraf": "^5.0.5",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  }
}